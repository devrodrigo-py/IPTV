<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext permanece permitido: streams IPTV sao majoritariamente http
     (natureza do ecossistema; ADR-005 cobre o TLS opt-in por fonte).
     Certificados de usuario NAO sao confiaveis em producao - apenas os do
     sistema - para que um cert instalado no dispositivo nao possa
     interceptar o trafego (inclusive credenciais de paineis). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
