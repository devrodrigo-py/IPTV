<?xml version="1.0" encoding="utf-8"?>
<!--
  IPTV providers almost always serve streams, logos and guides over plain HTTP
  on custom ports. Cleartext must be allowed or nothing plays.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
